# The RAG chat demo runs with a local fallback when no key is set.
# Set one of these to stream real answers from an OpenAI-compatible model.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Convenience: setting GROQ_API_KEY alone defaults the base URL to Groq.
GROQ_API_KEY=

# Used for canonical URLs, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://sumitjadhwani.vercel.app
